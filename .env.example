# H5 uses the Vite /api proxy; WeChat requires a reachable HTTPS API origin.
VITE_API_BASE_URL=
# WeChat Word downloads require a reachable public HTTPS website serving /static/resume-templates/.
# This is public client configuration, not a secret. H5 downloads use their own site origin.
VITE_TEMPLATE_BASE_URL=
API_PORT=3001
# Server only. Use HTTPS origins and secure cookies behind the production proxy.
AUTH_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AUTH_SECURE_COOKIES=false
# Server-only. Comma-separated IDs of existing verified email accounts. Empty disables admin access.
ADMIN_USER_IDS=
# Server-only SMTP settings. Keep MAIL_ENABLED=false until credentials are configured.
MAIL_ENABLED=false
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# At least 32 random bytes encoded as hex; do not reuse the SMTP password.
MAIL_CODE_SECRET=

# Server-only Tencent Cloud SMS. Credentials, approved signature, template and SDKAppID are required.
# Leave disabled until the signature/template are approved and a real delivery test is authorized.
SMS_ENABLED=false
SMS_PROVIDER=tencent
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
# Optional temporary credential session token.
TENCENT_SMS_TOKEN=
# Independent random secret (at least 32 bytes); never reuse SecretKey, SMTP or model secrets.
SMS_CODE_SECRET=
# Rolling 24-hour global request reservation limit, including failed submissions.
SMS_DAILY_LIMIT=100

# 微信支付 v3（仅服务器；全部配置后才启用，否则页面保持支付关闭）
WECHAT_PAY_APPID=
WECHAT_PAY_APP_SECRET=
WECHAT_PAY_MCHID=
WECHAT_PAY_MERCHANT_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PUBLIC_KEY_PATH=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_NOTIFY_URL=https://www.youfangcv.site/api/v1/billing/wechat/notify
# 支付宝网页支付（电脑网站支付 + 手机网站支付，仅服务器；全部配置后才启用）
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_PUBLIC_KEY_PATH=
ALIPAY_NOTIFY_URL=https://www.youfangcv.site/api/v1/billing/alipay/notify
ALIPAY_RETURN_URL=https://www.youfangcv.site/
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# 可选价格覆盖，单位分；默认初级 990、高级 2490、原价 2990
MEMBERSHIP_BASIC_PRICE_CENTS=
MEMBERSHIP_PREMIUM_PRICE_CENTS=
MEMBERSHIP_PREMIUM_LIST_PRICE_CENTS=
MEMBERSHIP_PREMIUM_PROMOTION_LABEL=
