{
  "name": "resume-youfang",
  "version": "0.1.0",
  "scripts": {
    "references:fetch": "node scripts/collect-resume-references.mjs",
    "references:build": "node scripts/build-resume-library.mjs",
    "references:check": "node scripts/check-resume-library.mjs",
    "career:build": "tsx scripts/build-career-library.ts",
    "career:check": "tsx scripts/build-career-library.ts --check",
    "companies:import": "tsx scripts/import-company-library.ts",
    "dev": "concurrently -k -n api,web -c cyan,blue \"npm:dev:api\" \"npm:dev:h5\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build": "npm run career:check && npm run type-check && npm run build:h5 && npm run build:mp-weixin",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:server": "npm run career:check && tsc -p tsconfig.server.json && node scripts/copy-server-assets.mjs",
    "mail:verify": "tsx scripts/verify-mail.ts",
    "build:release": "npm run build && npm run build:server && node scripts/package-release.mjs && npm run release:verify",
    "release:verify": "node deploy/verify-release.mjs dist/release",
    "type-check": "vue-tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020420260813003",
    "@dcloudio/uni-components": "3.0.0-5020420260813003",
    "@dcloudio/uni-h5": "3.0.0-5020420260813003",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020420260813003",
    "jszip": "^3.10.2",
    "mammoth": "1.13.0",
    "nodemailer": "10.2.1",
    "pdfjs-dist": "6.4.299",
    "pdfkit": "^0.20.2",
    "qrcode-generator": "^2.0.4",
    "vue": "^3.4.21",
    "vue-i18n": "^9.1.9",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-cli-shared": "3.0.0-5020420260813003",
    "@dcloudio/uni-stacktracey": "3.0.0-5020420260813003",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020420260813003",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@vue/runtime-core": "^3.4.21",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "5.2.8",
    "vue-tsc": "^3.1.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  }
}
